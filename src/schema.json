{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "$defs": {
    "person": {
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "pgp": { "type": "string", "pattern": "^[a-fA-F0-9]{40}$" }
      },
      "required": ["email", "name", "pgp"],
      "additionalProperties": true
    }
  },
  "properties": {
    "author": { "$ref": "#/$defs/person" },
    "maintainer": { "$ref": "#/$defs/person" },
    "copyright": { "type": "string" },
    "fund": {
      "type": "object",
      "properties": {
        "btc": { "type": "string", "pattern": "^[a-zA-Z0-9]+$" },
        "eth": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
        "monero": { "type": "string", "pattern": "^[a-zA-Z0-9]+$" }
      },
      "required": ["btc", "eth", "monero"]
    },
    "license": { "type": "string" },
    "locate": {
      "type": "object",
      "properties": {
        "rel": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "tgzbase": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "vcs": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "www": { "type": "array", "items": { "type": "string", "format": "uri" } }
      }
    },
    "name": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
    "releases": {
      "type": "object",
      "patternProperties": {
        "^[0-9]+\\.[0-9]+\\.[0-9]+$": {
          "type": "object",
          "properties": {
            "archive": { "type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$" },
            "changelog": { "type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$" },
            "author": { "$ref": "#/$defs/person" },
            "maintainer": { "$ref": "#/$defs/person" },
            "contributors": {
              "type": "array",
              "items": { "$ref": "#/$defs/person" }
            },
            "timestamp": { "type": "number" }
          },
          "required": ["archive", "changelog", "author", "maintainer", "timestamp"]
        }
      }
    },
    "sign": {
      "type": "object",
      "properties": {
        "ed22519": { "type": "string", "pattern": "^[a-fA-F0-9]+$" },
        "rsa": { "type": "string", "pattern": "^[a-fA-F0-9]+$" },
        "secp256k1": { "type": "string", "pattern": "^[a-fA-F0-9]+$" }
      },
      "required": ["ed25519", "rsa", "secp256k1"]
    },
    "slug": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
    "summary": { "type": "string" },
    "tech": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
    "vcs": {
      "type": "object",
      "properties": {
        "tag_prefix": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" }
      },
      "required": ["tag_prefix"]
    }
  },
  "required": ["author", "license", "name", "releases", "slug", "summary", "tech"]
}
